# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cou_bus_tracker
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_very_long_secret_key_here_at_least_32_characters

# Server Port
SERVER_PORT=8080

# Cloudinary Configuration (Image Upload)
# Get these from https://cloudinary.com/console after creating an account.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional email (MailerSend SMTP)
# Create a MailerSend SMTP user and verify the sending domain first.
MAILERSEND_SMTP_USERNAME=your_mailersend_smtp_username
MAILERSEND_SMTP_PASSWORD=your_mailersend_smtp_password
MAILERSEND_SMTP_HOST=smtp.mailersend.net
MAILERSEND_SMTP_PORT=2525
MAILERSEND_FROM_EMAIL=noreply@your-verified-domain.com
MAILERSEND_FROM_NAME=CoU Bus Tracker
